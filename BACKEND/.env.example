# ==============================
# VAN-CARD-NEWS-Generator Backend
# Local development environment
# ==============================

# 운영 환경의 시크릿은 Git에 커밋하지 않습니다.
# Cloud Run 운영 시 OPENAI_API_KEY / DATABASE_PASSWORD는
# Google Cloud Secret Manager에서 주입합니다.
# 실제 값은 이 파일에 작성하지 마세요.

DATABASE_URL=jdbc:postgresql://db:5432/van_card_news_db
DATABASE_USERNAME=van_web
DATABASE_PASSWORD=change_me

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.2
OPENAI_MAX_TOKENS=2048

HIGGSFIELD_API_KEY_ID=your_higgsfield_api_key_id
HIGGSFIELD_API_KEY_SECRET=your_higgsfield_api_key_secret
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
HIGGSFIELD_MODEL=higgsfield-ai/soul/standard
HIGGSFIELD_POLL_INTERVAL_MS=2000
HIGGSFIELD_MAX_POLL_COUNT=150

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

LOG_LEVEL_ROOT=INFO
SERVER_ERROR_INCLUDE_MESSAGE=always
SERVER_ERROR_INCLUDE_STACKTRACE=on_param
SERVER_ERROR_INCLUDE_BINDING_ERRORS=always

APP_UPLOAD_DIR=/app/uploads
APP_UPLOAD_PUBLIC_BASE_URL=http://localhost:8080/uploads
APP_GENERATED_DIR=/app/generated
APP_GENERATED_PUBLIC_BASE_URL=http://localhost:8080/generated

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
